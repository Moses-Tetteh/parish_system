# ---- Runtime (Vercel → Project → Settings → Environment Variables) ----
# Supabase "Transaction pooler" string (port 6543), user = parish_app.<project-ref>
DATABASE_URL="postgresql://parish_app.PROJECTREF:APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_SSL=require

# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Always on Vercel (HTTPS). Enables the __Host- cookie prefix + Secure flag.
COOKIE_SECURE=always
SESSION_IDLE_MINUTES=120
# 16+ random chars; Vercel Cron sends it as "Authorization: Bearer <value>"
CRON_SECRET=
APP_NAME="Blessed Clementina Parish"
TZ=Africa/Accra

# ---- Only on YOUR machine / CI for migrations and data import (never in Vercel) ----
# Supabase "Direct connection" (port 5432), owner user `postgres`
# DIRECT_URL="postgresql://postgres:OWNER_PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"
